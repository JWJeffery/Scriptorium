DATABASE_URL="postgresql://scriptorium:scriptorium@localhost:5432/scriptorium"
# Only needed once, to copy an existing MySQL database into PostgreSQL (see docs/POSTGRES_MIGRATION.md).
# SCRIPTORIUM_MYSQL_SOURCE_URL="mysql://scriptorium:scriptorium@localhost:3306/scriptorium"
SCRIPTORIUM_STORAGE_DIR="./storage"

# Application login: a sign-in page (/login) with a 14-day session cookie, enforced by
# apps/web/middleware.ts. HTTP basic auth with the same credentials is still accepted
# for scripts (e.g. a scheduled backup via curl -u).
# Required in production; the app answers 503 until both are set.
# Use a long random password, and a different one from any host-level gate.
SCRIPTORIUM_AUTH_USER=""
SCRIPTORIUM_AUTH_PASSWORD=""
# Optional: a long random string used to sign login cookies (defaults to a key derived
# from the user and password; changing either signs everyone out).
# SCRIPTORIUM_SESSION_SECRET=""
# Set to "true" only to deliberately run production with no in-app login
# (CI smoke tests, or a host that already authenticates every URL).
# SCRIPTORIUM_AUTH_DISABLED="true"
# Use an absolute path OUTSIDE the web root on the server, e.g. /home/<user>/scriptorium-storage

# Automated tests only: turns off the built-in rate limits so a test run can fire many requests
# from one address. Never set this on a real deployment.
# SCRIPTORIUM_RATE_LIMITS_DISABLED="true"

# Where uploaded files (originals, snapshots, job results) live. Default: the local folder above.
# To use S3-compatible object storage (Cloudflare R2, Backblaze B2, AWS S3, SeaweedFS...), first copy
# the files across with `node scripts/migrate-files-to-s3.mjs` (see docs/OBJECT_STORAGE.md), then set:
# SCRIPTORIUM_STORAGE_BACKEND="s3"
# SCRIPTORIUM_S3_BUCKET="scriptorium"
# SCRIPTORIUM_S3_ENDPOINT="http://localhost:8333"   # leave out for AWS S3 itself
# SCRIPTORIUM_S3_REGION="us-east-1"                  # "auto" for Cloudflare R2
# SCRIPTORIUM_S3_ACCESS_KEY_ID=""
# SCRIPTORIUM_S3_SECRET_ACCESS_KEY=""
# SCRIPTORIUM_S3_CREATE_BUCKET="true"                # development only
