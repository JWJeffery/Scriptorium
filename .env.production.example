# Copy to .env.production on the server and fill in. Never commit the real file.

# Your address, exactly as it will appear in the browser (the DNS record must already point at this server).
SCRIPTORIUM_DOMAIN=app.example.org

# The dashboard's address (its DNS record must also point at this server).
DASHBOARD_DOMAIN=dashboard.example.org
DASHBOARD_AUTH_USER=
DASHBOARD_AUTH_PASSWORD=
# Signs the dashboard's login cookies. Leave empty to derive it from the user and password.
DASHBOARD_SESSION_SECRET=
# DASHBOARD_TIMEZONE=America/New_York
# Google sign-in for the dashboard's Calendar card (docs/DASHBOARD_PLAN.md says how to get these two). Leave empty until then.
DASHBOARD_GOOGLE_CLIENT_ID=
DASHBOARD_GOOGLE_CLIENT_SECRET=
# Optional: encrypts the saved Google sign-in. Empty = the dashboard password is used (changing it then means reconnecting Google once).
DASHBOARD_ENCRYPTION_KEY=

# Passwords: use long random ones (for example from `openssl rand -base64 32`).
POSTGRES_PASSWORD=
SCRIPTORIUM_AUTH_USER=
SCRIPTORIUM_AUTH_PASSWORD=
# Signs login cookies. Changing it signs everyone out. Leave empty to derive it from the user and password.
SCRIPTORIUM_SESSION_SECRET=

# Optional: keep uploaded files in S3-compatible storage (Cloudflare R2, Backblaze B2) instead of the server's disk.
# SCRIPTORIUM_STORAGE_BACKEND=s3
# SCRIPTORIUM_S3_BUCKET=
# SCRIPTORIUM_S3_ENDPOINT=
# SCRIPTORIUM_S3_REGION=auto
# SCRIPTORIUM_S3_ACCESS_KEY_ID=
# SCRIPTORIUM_S3_SECRET_ACCESS_KEY=

# Optional: Add a book > From Google Drive / From Box. Leave empty to hide that option. Step-by-step setup (free):
# docs/CLOUD_IMPORT.md
SCRIPTORIUM_GOOGLE_CLIENT_ID=
SCRIPTORIUM_GOOGLE_API_KEY=
SCRIPTORIUM_GOOGLE_APP_ID=
SCRIPTORIUM_BOX_CLIENT_ID=
SCRIPTORIUM_BOX_CLIENT_SECRET=
