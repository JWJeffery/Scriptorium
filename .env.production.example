# Copy to .env.production on the server and fill in. Never commit the real file.

# Your address, exactly as it will appear in the browser (the DNS record must already point at this server).
SCRIPTORIUM_DOMAIN=app.example.org

# Passwords: use long random ones (for example from `openssl rand -base64 32`).
POSTGRES_PASSWORD=
SCRIPTORIUM_AUTH_USER=
SCRIPTORIUM_AUTH_PASSWORD=
# Signs login cookies. Changing it signs everyone out. Leave empty to derive it from the user and password.
SCRIPTORIUM_SESSION_SECRET=

# Optional: keep uploaded files in S3-compatible storage (Cloudflare R2, Backblaze B2) instead of the server's disk.
# SCRIPTORIUM_STORAGE_BACKEND=s3
# SCRIPTORIUM_S3_BUCKET=
# SCRIPTORIUM_S3_ENDPOINT=
# SCRIPTORIUM_S3_REGION=auto
# SCRIPTORIUM_S3_ACCESS_KEY_ID=
# SCRIPTORIUM_S3_SECRET_ACCESS_KEY=
