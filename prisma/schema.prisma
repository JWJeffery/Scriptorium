generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum DocumentKind {
  PDF
  DOCX
  OFFICE
  GOOGLE_DOC
  GOOGLE_SHEET
  GOOGLE_SLIDE
  TXT
  MARKDOWN
  OTHER
}

enum SnapshotKind {
  ORIGINAL
  PDF_RENDERING
  TEXT_EXTRACTION
  HTML_RENDERING
  IMAGE_SCAN
}

enum PageNumberingSystem {
  ARABIC
  ROMAN
  UNNUMBERED
  APPENDIX
  FOLIO
  CUSTOM
}

enum MappingConfidence {
  IMPORTED
  INFERRED
  USER_CONFIRMED
  UNCERTAIN
}

enum ResearchThreadItemType {
  DOCUMENT
  ANNOTATION
  CITATION
  SOURCE
  NOTE
}

model Document {
  id               String            @id @default(cuid())
  title            String            @db.VarChar(512)
  originalFilename String?           @db.VarChar(512)
  kind             DocumentKind
  mediaType        String?           @db.VarChar(255)
  storageKey       String?           @db.VarChar(1024)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  versions         DocumentVersion[]
  sources          Source[]
  annotations      Annotation[]
  bookmarks        Bookmark[]
  embeddings       PassageEmbedding[]

  @@index([title])
}

model DocumentVersion {
  id              String       @id @default(cuid())
  documentId      String
  document        Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sourceChecksum  String?      @db.VarChar(255)
  snapshotKind    SnapshotKind
  snapshotKey     String?      @db.VarChar(1024)
  extractionState String       @default("pending") @db.VarChar(255)
  createdAt       DateTime     @default(now())
  pages           PageMap[]
  pageRanges      PageRange[]
  textSpans       TextSpan[]
  annotations     Annotation[]

  @@index([documentId])
}

model Source {
  id          String     @id @default(cuid())
  documentId  String?
  document    Document?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  shortTitle  String?    @db.VarChar(512)
  cslJson     Json
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  citations   Citation[]

  @@index([documentId])
}

model PageMap {
  id              String              @id @default(cuid())
  versionId       String
  version         DocumentVersion     @relation(fields: [versionId], references: [id], onDelete: Cascade)
  pdfPageIndex    Int
  visibleLabel    String?             @db.VarChar(64)
  bookPageLabel   String?             @db.VarChar(64)
  numberingSystem PageNumberingSystem @default(ARABIC)
  confidence      MappingConfidence   @default(UNCERTAIN)
  note            String?             @db.Text
  annotations     Annotation[]
  textSpans       TextSpan[]

  @@unique([versionId, pdfPageIndex])
  @@index([bookPageLabel])
}

// Search-by-meaning index: one vector per passage of a book's text (kind "page")
// or per saved note (kind "annotation"). It is derived data and can always be
// rebuilt, so it is left out of backups.
model PassageEmbedding {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  kind       String   @db.VarChar(16)
  refId      String   @db.VarChar(191)
  pdfPage    Int?
  startChar  Int      @default(0)
  endChar    Int      @default(0)
  textHash   String   @db.VarChar(40)
  model      String   @db.VarChar(64)
  vector     Bytes
  createdAt  DateTime @default(now())

  @@index([documentId, kind])
  @@index([refId])
}

// A place marked in a book, to come back to.
model Bookmark {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pdfPage    Int
  label      String?  @db.VarChar(255)
  createdAt  DateTime @default(now())

  @@unique([documentId, pdfPage])
}

// Printed page numbering for a stretch of PDF pages: a Roman-numeral preface,
// the Arabic body, an appendix "A-1, A-2, ...", or pages with no number at all.
// `system` is one of: arabic, roman-lower, roman-upper, unnumbered.
// `startValue` is the number printed on `startPdfPage`; the number then rises by
// one per page. `endPdfPage` null means "to the end of the book".
model PageRange {
  id           String          @id @default(cuid())
  versionId    String
  version      DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  startPdfPage Int
  endPdfPage   Int?
  system       String          @db.VarChar(32)
  startValue   Int             @default(1)
  prefix       String          @default("") @db.VarChar(16)
  note         String?         @db.VarChar(255)

  @@index([versionId, startPdfPage])
}

model TextSpan {
  id        String          @id @default(cuid())
  versionId String
  version   DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  pageMapId String?
  pageMap   PageMap?        @relation(fields: [pageMapId], references: [id], onDelete: SetNull)
  text      String          @db.LongText
  anchor    Json?
  createdAt DateTime        @default(now())

  @@index([versionId])
  @@index([pageMapId])
}

model Annotation {
  id           String          @id @default(cuid())
  documentId   String
  document     Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionId    String
  version      DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  pageMapId    String?
  pageMap      PageMap?        @relation(fields: [pageMapId], references: [id], onDelete: SetNull)
  colorKey     String          @db.VarChar(64)
  selectedText String          @db.LongText
  note         String?         @db.LongText
  anchor       Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  citations    Citation[]
  tags         AnnotationTag[]

  @@index([documentId])
  @@index([versionId])
  @@index([pageMapId])
  @@index([colorKey])
}

model AnnotationTag {
  id           String     @id @default(cuid())
  annotationId String
  annotation   Annotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  value        String     @db.VarChar(128)

  @@unique([annotationId, value])
  @@index([value])
}

model Citation {
  id                      String      @id @default(cuid())
  sourceId                String
  source                  Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  annotationId            String?
  annotation              Annotation? @relation(fields: [annotationId], references: [id], onDelete: SetNull)
  styleId                 String      @db.VarChar(128)
  locale                  String      @default("en-US") @db.VarChar(32)
  locatorType             String      @default("page") @db.VarChar(64)
  locatorValue            String?     @db.VarChar(255)
  prefix                  String?     @db.Text
  suffix                  String?     @db.Text
  generatedText           String      @db.LongText
  createdAt               DateTime    @default(now())
  // Snapshot of Source.updatedAt at the moment this citation was generated.
  // Staleness = sourceSnapshotUpdatedAt < source.updatedAt. Defaulting to
  // now() for pre-existing rows is a deliberately conservative choice: it
  // means citations generated before this field existed read as "possibly
  // stale" rather than silently reading as fresh.
  sourceSnapshotUpdatedAt DateTime    @default(now())
  // Regeneration lineage. A regenerated citation is a NEW row that points
  // back at the one it replaces, per ARCHITECTURE.md's regeneration rule:
  // "offer regeneration rather than silently changing old research notes."
  // The superseded row is left in place untouched.
  supersedesCitationId    String?     @unique
  supersedesCitation      Citation?   @relation("CitationRegeneration", fields: [supersedesCitationId], references: [id], onDelete: SetNull)
  supersededBy            Citation?   @relation("CitationRegeneration")

  @@index([sourceId])
  @@index([annotationId])
  @@index([styleId])
}

model ResearchThread {
  id          String               @id @default(cuid())
  title       String               @db.VarChar(512)
  description String?              @db.LongText
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  items       ResearchThreadItem[]
  tags        ResearchThreadTag[]
}

model ResearchThreadTag {
  id               String         @id @default(cuid())
  researchThreadId String
  researchThread   ResearchThread @relation(fields: [researchThreadId], references: [id], onDelete: Cascade)
  value            String         @db.VarChar(128)

  @@unique([researchThreadId, value])
  @@index([value])
}

model ResearchThreadItem {
  id               String                 @id @default(cuid())
  researchThreadId String
  researchThread   ResearchThread         @relation(fields: [researchThreadId], references: [id], onDelete: Cascade)
  itemType         ResearchThreadItemType
  itemId           String
  note             String?                @db.LongText
  orderIndex       Int                    @default(0)

  @@index([researchThreadId])
  @@index([itemType, itemId])
}

model QueryLog {
  id        String   @id @default(cuid())
  query     String   @db.LongText
  mode      String   @db.VarChar(128)
  filters   Json?
  resultIds Json?
  createdAt DateTime @default(now())
}
